# Copy to .env and adjust. Every value has a working default for TEST_ENV=staging,
# so an empty .env still runs. Nothing here is a secret: the target is a public sandbox.
#
# One value does NOT belong here: NODE_EXTRA_CA_CERTS. Node reads it when the
# process starts, which is before this file is loaded, so setting it here has no
# effect. Export it in the shell instead — see the proxy section of README.md.

# Which environment block in src/config/environments.ts to use.
# staging | local   (there is deliberately no "production" value — see env.ts guard)
TEST_ENV=staging

# Per-value overrides. Set these to point at a new environment WITHOUT a code change.
# API_BASE_URL=https://compassuol.serverest.dev
# UI_BASE_URL=https://front.serverest.dev

# The origin the shipped UI bundle has hardcoded. Requests to it are rewritten to
# API_BASE_URL at the network layer. See docs/ui-origin-rewrite.md.
# UI_HARDCODED_API_ORIGIN=https://serverest.dev
# UI_REWRITE_ORIGIN=true

# Email domain for generated test identities. Tags our data in the shared sandbox.
# TEST_EMAIL_DOMAIN=qa.testcia.dev

# Correlates every identity created by one run. CI should set this to the build id.
# TEST_RUN_ID=local

# Re-mint the JWT when it has fewer than this many seconds left. Token TTL is 600s.
# TOKEN_REFRESH_MARGIN_SECONDS=120

# Fail the run if teardown could not delete something it created. Default false:
# a cleanup failure warns loudly but does not mask the real test result.
# STRICT_CLEANUP=false

# Fail a test when a response shape does not match swagger.json. Default false
# (report only) so contract drift surfaces without turning every test red.
# STRICT_CONTRACT=false
